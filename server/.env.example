PORT=5000
# Replica set required. Never use your production DB for local development or tests.
MONGODB_URI=mongodb://127.0.0.1:27017/paddysync?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
DNS_SERVERS=
JWT_SECRET=replace-with-at-least-32-random-characters
ORGANIZATION_NAME=PaddySync
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
# Only used to bootstrap an EMPTY installation. Existing data requires explicit migration.
LEGACY_BEARER_LOGIN=false
ENABLE_LIVE_PAYMENTS=false
# Set only when behind a known trusted reverse proxy, e.g. 1 for exactly one hop.
TRUST_PROXY_HOPS=
# Optional AI. Choose a Responses/function-calling-capable model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Base64-encoded 32 random bytes. Keep in a secret manager, with rotation/backup procedures.
BENEFICIARY_ENCRYPTION_KEY=
# Example naming convention; replace ORGANIZATION_ID with the uppercase organization ObjectId.
# CASHFREE_ORGANIZATION_ID_TEST_CLIENT_ID=
# CASHFREE_ORGANIZATION_ID_TEST_SECRET=
# CASHFREE_ORGANIZATION_ID_LIVE_CLIENT_ID=
# CASHFREE_ORGANIZATION_ID_LIVE_SECRET=
